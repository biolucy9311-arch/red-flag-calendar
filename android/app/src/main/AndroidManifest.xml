<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ Permiso para Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Permiso para notificaciones en Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="redflag_calendar"
        android:icon="@mipmap/ic_launcher">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7048865196122338~2511845167"/> 

        <!-- Receptores de Awesome Notifications -->
        <receiver
            android:name="me.carda.awesome_notifications.notifications.receivers.NotificationReceiver"
            android:exported="true" />
        <receiver
            android:name="me.carda.awesome_notifications.notifications.receivers.ActionReceiver"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Requerido por Flutter para copiar/pegar texto -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

</manifest>